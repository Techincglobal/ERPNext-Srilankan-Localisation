[
 {
  "doctype": "Print Format",
  "name": "Tax Invoice - LK",
  "doc_type": "Sales Invoice",
  "module": "Erpnext Srilankan Localisation",
  "print_format_type": "Jinja",
  "custom_format": 1,
  "standard": "No",
  "disabled": 0,
  "pdf_generator": "wkhtmltopdf",
  "margin_top": 20.0,
  "margin_bottom": 40.0,
  "margin_left": 0.0,
  "margin_right": 0.0,
  "page_number": "Hide",
  "font_size": 14,
  "absolute_value": 0,
  "align_labels_right": 0,
  "default_print_language": "en",
  "line_breaks": 0,
  "print_format_builder": 0,
  "print_format_builder_beta": 0,
  "raw_printing": 0,
  "show_section_headings": 0,
  "docstatus": 0,
  "html": "<style>\n    .print-format {\n        margin-left: 0mm;\n        margin-right: 0mm;\n        font-family: Arial, sans-serif;\n    }\n\n    .print-format td, .print-format th {\n        padding: 3px !important;\n    }\n\n    .content {\n        margin-left: 15mm;\n        margin-right: 15mm;\n    }\n</style>\n\n{% if letter_head and not no_letterhead -%}\n    <div id=\"header-html\">\n        <div class=\"letter-head\">{{ letter_head }}</div>\n    </div>\n{%- endif %}\n\n{% if footer %}\n    <div id=\"footer-html\">\n        {{ footer }}\n    </div>\n{% endif %}\n\n{% set customer_billing_currency = frappe.db.get_value(\"Customer\", doc.customer, \"default_currency\") or doc.currency %}\n{% set currency_symbol = frappe.db.get_value(\"Currency\", customer_billing_currency, \"symbol\") or doc.currency %}\n\n{# -- WHT totals -- #}\n{% set wht = namespace(total=0) %}\n{% for tax in doc.taxes %}\n    {% if tax.is_tax_withholding_account %}\n        {% set wht.total = wht.total + (tax.tax_amount or 0) %}\n    {% endif %}\n{% endfor %}\n{% set has_wht = wht.total > 0 %}\n{% set pre_wht_grand = doc.grand_total - wht.total %}\n{% set net_payable = pre_wht_grand - wht.total %}\n\n<br>\n<div class=\"content\">\n    <h4 style=\"text-align: center;\">Tax Invoice</h4>\n\n    <table width=\"100%\">\n        {% set purchaser = frappe.get_doc(\"Customer\", doc.customer) %}\n        {% set supplier = frappe.get_doc(\"Company\", doc.company) %}\n        {% set supplier_contact = get_contact_number_from_contact(doc.company_contact_person) if doc.company_contact_person else {} %}\n        {% set purchaser_contact = get_contact_number_from_contact(doc.contact_person) if doc.contact_person else {} %}\n\n        <tr>\n            <td width=\"20%\" style=\"color:black; font-size: 10px; padding: 3px !important; font-weight:bold;\">Supplier's TIN:</td>\n            <td width=\"30%\" style=\"color:black; font-size: 10px; padding: 3px !important;\">{{ supplier.lk_tin_no or \"\" }}</td>\n            <td width=\"20%\" style=\"color:black; font-size: 10px; padding: 3px !important; font-weight:bold;\">Purchaser's TIN:</td>\n            <td width=\"30%\" style=\"color:black; font-size: 10px; padding: 3px !important;\">{{ doc.lk_customer_tin_no or \"\" }}</td>\n        </tr>\n\n        <tr>\n            <td style=\"color:black; font-size: 10px; padding: 3px !important; font-weight:bold;\">Supplier's Name:</td>\n            <td style=\"color:black; font-size: 10px; padding: 3px !important;\">{{ supplier.company_name }}</td>\n            <td style=\"color:black; font-size: 10px; padding: 3px !important; font-weight:bold;\">Purchaser's Name:</td>\n            <td style=\"color:black; font-size: 10px; padding: 3px !important;\">{{ purchaser.customer_name or \"\" }}</td>\n        </tr>\n\n        <tr>\n            <td style=\"color:black; font-size: 10px; padding: 3px !important; font-weight:bold;\">Supplier's Address:</td>\n            <td style=\"color:black; font-size: 10px; padding: 3px !important;\">{{ doc.company_address_display or \"\" }}</td>\n            <td style=\"color:black; font-size: 10px; padding: 3px !important; font-weight:bold;\">Purchaser's Address:</td>\n            <td style=\"color:black; font-size: 10px; padding: 3px !important;\">{{ get_address_display(doc.customer_address) | safe }}</td>\n        </tr>\n\n        <tr>\n            <td style=\"color:black; font-size: 10px; padding: 3px !important; font-weight:bold;\">Supplier's Tel:</td>\n            <td style=\"color:black; font-size: 10px; padding: 3px !important;\">{{ supplier_contact.primary_phone or \"\" }}<br>{{ supplier_contact.contact_name or \"\" }}</td>\n            <td style=\"color:black; font-size: 10px; padding: 3px !important; font-weight:bold;\">Purchaser's Tel:</td>\n            <td style=\"color:black; font-size: 10px; padding: 3px !important;\">{{ purchaser_contact.primary_phone or \"\" }}<br>{{ purchaser_contact.contact_name or \"\" }}</td>\n        </tr>\n    </table>\n\n    <br>\n\n    <table width=\"100%\">\n        <tr>\n            <td width=\"20%\" style=\"color:black; font-size: 10px; padding: 3px !important; font-weight:bold;\">Date of Invoice:</td>\n            <td width=\"30%\" style=\"color:black; font-size: 10px; padding: 3px !important;\">\n                {{ frappe.utils.formatdate(doc.posting_date, \"MM/dd/yyyy\") }}\n            </td>\n            <td width=\"20%\" style=\"color:black; font-size: 10px; padding: 3px !important; font-weight:bold;\">Tax Invoice No.:</td>\n            <td width=\"30%\" style=\"color:black; font-size: 10px; padding: 3px !important;\">{{ doc.name }}</td>\n        </tr>\n    </table>\n\n    <table width=\"100%\">\n        <tr>\n            <td width=\"20%\" style=\"color:black; font-size: 10px; padding: 3px !important; font-weight:bold;\">Date of Delivery:</td>\n            <td width=\"30%\" style=\"color:black; font-size: 10px; padding: 3px !important;\"></td>\n            <td width=\"20%\" style=\"color:black; font-size: 10px; padding: 3px !important; font-weight:bold;\">Place of Supply:</td>\n            <td width=\"30%\" style=\"color:black; font-size: 10px; padding: 3px !important;\">\n                {{ get_address_display(doc.dispatch_address_name) | safe or get_address_display(doc.customer_address) | safe }}\n            </td>\n        </tr>\n    </table>\n\n    <br>\n\n    {% if doc.remarks and doc.remarks != \"No Remarks\" %}\n        <h5 style=\"color:black; font-size: 10px; font-weight:bold;\">Additional Information</h5>\n        {{ doc.remarks }}\n    {% endif %}\n\n    <table width=\"100%\">\n        <tr>\n            <td width=\"25%\" style=\"color:black; font-size: 10px; border: 1px solid; padding: 3px !important; font-weight:bold; text-align:center;\">Reference</td>\n            <td width=\"36%\" style=\"color:black; font-size: 10px; border: 1px solid; padding: 3px !important; font-weight:bold; text-align:center;\">Description of Goods or Services</td>\n            <td width=\"12%\" style=\"color:black; font-size: 10px; border: 1px solid; padding: 3px !important; font-weight:bold; text-align:center;\">Quantity</td>\n            <td width=\"12%\" style=\"color:black; font-size: 10px; border: 1px solid; padding: 3px !important; font-weight:bold; text-align:center;\">Rate</td>\n            <td width=\"15%\" style=\"color:black; font-size: 10px; border: 1px solid; padding: 3px !important; font-weight:bold; text-align:center;\">Amount Excluding VAT ({{ customer_billing_currency }})</td>\n        </tr>\n\n        {% for item in doc.items %}\n            <tr>\n                <td style=\"color:black; font-size: 10px; border: 1px solid; padding: 3px !important; text-align:center;\">{{ item.item_code or \"\" }}</td>\n                <td style=\"color:black; font-size: 10px; border: 1px solid; padding: 3px !important;\">{{ item.description }}</td>\n                <td style=\"color:black; font-size: 10px; border: 1px solid; padding: 3px !important; text-align:right;\">{{ item.uom }} {{ \"{:,.1f}\".format(item.qty) }}</td>\n                <td style=\"color:black; font-size: 10px; border: 1px solid; padding: 3px !important; text-align:right;\">{{ currency_symbol }} {{ \"{:,.2f}\".format(item.price_list_rate or item.rate) }}</td>\n                <td style=\"color:black; font-size: 10px; border: 1px solid; padding: 3px !important; text-align:right;\">{{ currency_symbol }} {{ \"{:,.2f}\".format(item.amount) }}</td>\n            </tr>\n        {% endfor %}\n\n        <tr>\n            <td colspan=\"4\" style=\"color:black; font-size: 10px; border: 1px solid; padding: 3px !important; text-align:left; font-weight:bold;\">Total Value of Supply</td>\n            <td style=\"color:black; font-size: 10px; border: 1px solid; padding: 3px !important; text-align:right;\">{{ currency_symbol }} {{ \"{:,.2f}\".format(doc.net_total) }}</td>\n        </tr>\n\n        {% for tax in doc.taxes %}\n            {% if not tax.is_tax_withholding_account %}\n                <tr>\n                    <td colspan=\"4\" style=\"color:black; font-size: 10px; border: 1px solid; padding: 3px !important; text-align:left; font-weight:bold;\">\n                        {{ tax.description or tax.account_head or \"Tax\" }}\n                        {% if tax.rate %}({{ \"{:,.2f}\".format(tax.rate) }}%){% endif %}\n                    </td>\n                    <td style=\"color:black; font-size: 10px; border: 1px solid; padding: 3px !important; text-align:right;\">{{ currency_symbol }} {{ \"{:,.2f}\".format(tax.tax_amount or 0) }}</td>\n                </tr>\n            {% endif %}\n        {% endfor %}\n\n        {% if not has_wht and doc.rounding_adjustment %}\n            <tr>\n                <td colspan=\"4\" style=\"color:black; font-size: 10px; border: 1px solid; padding: 3px !important; text-align:left; font-weight:bold;\">Rounding Adjustment</td>\n                <td style=\"color:black; font-size: 10px; border: 1px solid; padding: 3px !important; text-align:right;\">{{ currency_symbol }} {{ \"{:,.2f}\".format(doc.rounding_adjustment) }}</td>\n            </tr>\n        {% endif %}\n\n        {% if has_wht %}\n            <tr>\n                <td colspan=\"4\" style=\"color:black; font-size: 10px; border: 1px solid; padding: 3px !important; text-align:left; font-weight:bold;\">Total Amount including Tax</td>\n                <td style=\"color:black; font-size: 10px; border: 1px solid; padding: 3px !important; text-align:right;\">{{ currency_symbol }} {{ \"{:,.2f}\".format(pre_wht_grand) }}</td>\n            </tr>\n            <tr>\n                <td colspan=\"4\" style=\"color:black; font-size: 10px; border: 1px solid; padding: 3px !important; text-align:left; font-weight:bold;\">Less: Withholding Tax (WHT)</td>\n                <td style=\"color:black; font-size: 10px; border: 1px solid; padding: 3px !important; text-align:right;\">( {{ currency_symbol }} {{ \"{:,.2f}\".format(wht.total) }} )</td>\n            </tr>\n            <tr>\n                <td colspan=\"4\" style=\"color:black; font-size: 10px; border: 1px solid; padding: 3px !important; text-align:left; font-weight:bold;\">Net Amount Payable</td>\n                <td style=\"color:black; font-size: 10px; border: 1px solid; padding: 3px !important; text-align:right; font-weight:bold;\">{{ currency_symbol }} {{ \"{:,.2f}\".format(net_payable) }}</td>\n            </tr>\n        {% else %}\n            <tr>\n                <td colspan=\"4\" style=\"color:black; font-size: 10px; border: 1px solid; padding: 3px !important; text-align:left; font-weight:bold;\">Total Amount including Tax</td>\n                <td style=\"color:black; font-size: 10px; border: 1px solid; padding: 3px !important; text-align:right; font-weight:bold;\">{{ currency_symbol }} {{ \"{:,.2f}\".format(doc.rounded_total or doc.grand_total) }}</td>\n            </tr>\n        {% endif %}\n    </table>\n\n    <br>\n\n    {% set display_total = net_payable if has_wht else (doc.rounded_total or doc.grand_total) %}\n    {% set amount_in_words = frappe.utils.money_in_words(display_total, doc.currency) %}\n\n    <table width=\"100%\">\n        <tr>\n            <td width=\"30%\" style=\"color:black; font-size: 10px; font-weight:bold; padding: 3px !important;\">Total Amount in words:</td>\n            <td width=\"70%\" style=\"color:black; font-size: 10px; padding: 3px !important;\">{{ amount_in_words }}</td>\n        </tr>\n        <tr>\n            <td style=\"color:black; font-size: 10px; font-weight:bold; padding: 3px !important;\">Mode of Payment:</td>\n            <td style=\"color:black; font-size: 10px; padding: 3px !important;\">{{ doc.lk_mode_of_payment or \"\" }}</td>\n        </tr>\n    </table>\n\n    <br>\n    {{ doc.terms or \"\" }}\n</div>"
 }
]